<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<main class="container">
  <div class="page-header">
    <h1>Usuarios y asesores</h1>
    <a class="btn btn-primary" href="/admin/users/new">Nuevo usuario</a>
  </div>

  <%- include('../partials/flash') %>

  <section class="card">
    <% if (!users.length) { %>
      <p class="muted">No hay usuarios.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Usuario</th>
              <th>Nombre</th>
              <th>Rol</th>
              <th class="num">Comisión %</th>
              <th>Estado</th>
              <th class="num">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(function (u) { %>
              <tr>
                <td><%= u.username %></td>
                <td><%= u.full_name %></td>
                <td><span class="badge badge-<%= u.role === 'admin' ? 'shipped' : 'paid' %>"><%= u.role === 'admin' ? 'Admin' : 'Asesor' %></span></td>
                <td class="num"><%= u.commission_pct %> %</td>
                <td><span class="badge badge-<%= u.active ? 'paid' : 'cancelled' %>"><%= u.active ? 'Activo' : 'Inactivo' %></span></td>
                <td class="num">
                  <div class="btn-row">
                    <a class="btn btn-sm" href="/admin/users/<%= u.id %>/edit">Editar</a>
                    <% if (u.id !== currentUser.id) { %>
                      <form method="POST" action="/admin/users/<%= u.id %>/delete" onsubmit="return confirm('¿Eliminar este usuario?');">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</main>
<%- include('../partials/footer') %>
