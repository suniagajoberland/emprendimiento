<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<main class="container">
  <div class="page-header">
    <h1>Reporte de ventas</h1>
    <a class="btn btn-sm" href="/reports/sales.csv?from=<%= filters.from %>&to=<%= filters.to %><%= currentUser.role === 'admin' && filters.advisorId ? '&advisor_id=' + filters.advisorId : '' %>">Exportar CSV</a>
  </div>

  <%- include('../partials/flash') %>

  <form method="GET" action="/reports/sales" class="filters">
    <label class="field">
      Desde
      <input type="date" name="from" value="<%= filters.from %>" />
    </label>
    <label class="field">
      Hasta
      <input type="date" name="to" value="<%= filters.to %>" />
    </label>
    <% if (currentUser.role === 'admin') { %>
      <label class="field">
        Asesor
        <select name="advisor_id">
          <option value="">Todos</option>
          <% advisors.forEach(function (a) { %>
            <option value="<%= a.id %>" <%= String(filters.advisorId) === String(a.id) ? 'selected' : '' %>><%= a.full_name %></option>
          <% }) %>
        </select>
      </label>
    <% } %>
    <button type="submit" class="btn">Filtrar</button>
  </form>

  <section class="grid stats">
    <div class="card stat">
      <span class="stat-label">Órdenes</span>
      <span class="stat-value"><%= data.summary.orders %></span>
    </div>
    <div class="card stat">
      <span class="stat-label">Total USD</span>
      <span class="stat-value"><%= usd(data.summary.total_usd) %></span>
    </div>
    <div class="card stat">
      <span class="stat-label">Total Bs</span>
      <span class="stat-value gold"><%= bs(data.summary.total_bs) %></span>
    </div>
  </section>

  <section class="card">
    <% if (!data.rows.length) { %>
      <p class="muted">No hay ventas en el rango seleccionado.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Orden</th>
              <th>Fecha</th>
              <% if (currentUser.role === 'admin') { %><th>Asesor</th><% } %>
              <th>Cliente</th>
              <th>Estado</th>
              <th class="num">Total USD</th>
              <th class="num">Total Bs</th>
              <th class="num">Comisión %</th>
            </tr>
          </thead>
          <tbody>
            <% data.rows.forEach(function (r) { %>
              <tr>
                <td><a href="/orders/<%= r.id %>"><%= r.order_number %></a></td>
                <td><%= fmtDateTime(r.created_at) %></td>
                <% if (currentUser.role === 'admin') { %><td><%= r.advisor_name %></td><% } %>
                <td><%= r.customer_name %></td>
                <td><span class="badge badge-<%= r.status %>"><%= statusLabels[r.status] %></span></td>
                <td class="num"><%= usd(r.total_usd) %></td>
                <td class="num"><%= bs(r.total_bs) %></td>
                <td class="num"><%= r.commission_pct %> %</td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</main>
<%- include('../partials/footer') %>
